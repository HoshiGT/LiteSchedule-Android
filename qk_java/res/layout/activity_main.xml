<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F4F6FB"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:text="轻课表"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="简单、清爽的课程表"
                    android:textColor="#D9E0FF"
                    android:textSize="13sp"
                    android:paddingTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_settings"
                android:src="@drawable/ic_settings_gear"
                android:contentDescription="设置"
                android:background="@null"
                android:padding="8dp"
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_title"
            android:text="本周课程"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2D3142"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btn_prev_week"
            android:text="◀"
            android:textColor="#4C5C92"
            android:background="@drawable/bg_button_secondary"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:minWidth="0dp" />
        <TextView
            android:id="@+id/tv_current_week"
            android:text="第1周"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2D3142"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_next_week"
            android:text="▶"
            android:textColor="#4C5C92"
            android:background="@drawable/bg_button_secondary"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_today_week"
        android:text=""
        android:textSize="12sp"
        android:textColor="#6B7280"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/empty_panel"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:text="还没有课程"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2D3142"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/empty_hint"
            android:text="去设置里导入文件，或使用教务导入"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_go_import"
            android:text="去设置导入"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/week_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
