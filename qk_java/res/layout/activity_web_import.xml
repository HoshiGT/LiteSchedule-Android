<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F4F6FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="教务导入（自定义网址）"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:text="输入你自己学校的教务系统网址，登录后再导入课表。"
            android:textColor="#D9E0FF"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <Spinner
        android:id="@+id/sp_school_preset"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_box"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <EditText
        android:id="@+id/et_school_url"
        android:hint="输入学校教务系统网址，如 https://jwxt.example.edu.cn"
        android:textSize="14sp"
        android:textColor="#2D3142"
        android:textColorHint="#9AA3B5"
        android:background="@drawable/bg_search_box"
        android:padding="14dp"
        android:inputType="textUri"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_open_schedule"
            android:text="打开教务系统"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp" />
        <Button
            android:id="@+id/btn_import_schedule"
            android:text="导入当前课表"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_import_hint"
        android:text="请先输入学校教务网址并打开页面，再点导入；也可以在教务系统里导出 XLS/XML 后，到导入页选择文件识别。"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
