server {
    server_name schedule.hoshichan.moe;

    root /var/www/schedule.hoshichan.moe/html;
    index index.html;

    # 旧的直链 APK 统一走下载统计接口
    location ~ ^/(LiteSchedule-.*\.apk)$ {
        return 302 /api/qingkebiao/download/$1;
    }

    location /api/qingkebiao/ {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/schedule.hoshichan.moe/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/schedule.hoshichan.moe/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = schedule.hoshichan.moe) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name schedule.hoshichan.moe;
    return 404; # managed by Certbot


}
